generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  free
  founding_solo
  solo
  duo
  small_team
  studio
}

model User {
  id          String   @id // GitHub node_id
  githubId    Int      @unique @map("github_id")
  login       String
  email       String?
  avatarUrl   String?  @map("avatar_url")
  accessToken String   @map("access_token")
  planTier    PlanTier @default(free) @map("plan_tier")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  paddleCustomerId     String?   @map("paddle_customer_id")
  paddleSubscriptionId String?   @map("paddle_subscription_id")
  subscriptionStatus   String?   @map("subscription_status")
  subscriptionEndsAt   DateTime? @map("subscription_ends_at")
  billingPeriod        String?   @map("billing_period")
  prUsedThisMonth      Int       @default(0) @map("pr_used_this_month")
  billingCycleStart    DateTime? @map("billing_cycle_start")

  installations Installation[]

  @@map("users")
}

model Installation {
  id               Int       @id // GitHub installation_id
  userId           String    @map("user_id")
  accountLogin     String    @map("account_login")
  accountType      String    @map("account_type")
  accountAvatarUrl String?   @map("account_avatar_url")
  accessToken      String?   @map("access_token")
  tokenExpiresAt   DateTime? @map("token_expires_at")
  suspended        Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories Repository[]

  @@map("installations")
}

model Repository {
  id             Int      @id // GitHub repo id
  installationId Int      @map("installation_id")
  fullName       String   @map("full_name")
  private        Boolean  @default(false)
  defaultBranch  String   @default("main") @map("default_branch")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  reviews      PrReview[]

  @@map("repositories")
}

model PrReview {
  id           String   @id @default(cuid())
  repositoryId Int      @map("repository_id")
  prNumber     Int      @map("pr_number")
  commitSha    String   @map("commit_sha")
  status       String   @default("pending") // pending | processing | completed | failed
  reviewId     BigInt?  @map("review_id") // GitHub review ID (64-bit)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, prNumber, commitSha])
  @@map("pr_reviews")
}
